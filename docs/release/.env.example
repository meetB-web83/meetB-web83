# WorkJournal — optional configuration template.
# Copy to .env next to compose.yaml and uncomment what you need.
# Every value below already matches the default; the stack works with no .env at all.

# Release version tag to run (set when upgrading, e.g. 1.0.0).
#WORKJOURNAL_VERSION=1.0.0

# REQUIRED: host projects directory. Compose bind-mounts it into the core
# container at /host-projects. Windows:
#   PROJECTS_DIRECTORY=C:/Users/you/Documents/PROJECTS
# macOS / Linux:
#   PROJECTS_DIRECTORY=/Users/you/projects
# Docker Desktop (Windows/macOS): enable the drive/folder under
# Settings → Resources → File sharing first.
PROJECTS_DIRECTORY=

# Alternative registry / namespace (defaults to the release's own registry).
#WORKJOURNAL_REGISTRY=docker.io
#WORKJOURNAL_USER=your-dockerhub-username

# Host ports (bound to 127.0.0.1 only). If you change MCP_HOST_PORT, also set
# MCP_ALLOWED_HOSTS / MCP_ALLOWED_ORIGINS to include the new host:port values.
#WEB_PORT=3000
#MCP_HOST_PORT=3738
#MCP_ALLOWED_HOSTS=127.0.0.1:3738,localhost:3738,[::1]:3738
#MCP_ALLOWED_ORIGINS=http://127.0.0.1:3738,http://localhost:3738

# Optional bearer token for the MCP endpoint. When set, MCP clients must send
# "Authorization: Bearer <token>" with every /mcp request.
#MCP_AUTH_TOKEN=

# Core logging: fatal | error | warn | info | debug | trace
#LOG_LEVEL=info
