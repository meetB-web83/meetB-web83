# WorkJournal release bundle (generated artifact — do not edit by hand).
#
# Download this file from a GitHub release, then:
#
#   docker compose up -d
#
# Dashboard:  http://127.0.0.1:3000
# MCP:        http://127.0.0.1:3738/mcp
# Core API:   internal only — never published to the host.
#
# Persistent SQLite data lives in the named volume `workjournal-data`.
# `docker compose stop` / `docker compose down` keep it; only
# `docker compose down -v` deletes it.
#
# Overrides via a local .env file (see the released .env.example):
#   WORKJOURNAL_VERSION, WEB_PORT, MCP_HOST_PORT, MCP_AUTH_TOKEN, ...
#
# NOTE — project folders: WorkJournal stores each project's database at
# <project-root>/.workjournal/. The core service sees the world inside its
# container, so bind-mount the folders you want to track, e.g. in an override
# file docker-compose.override.yml:
#
#   services:
#     core:
#       volumes:
#         - /Users/you/code:/projects:ro
#
# and register the project with root_path /projects/<name>.

name: workjournal

services:
  core:
    image: __BASE__-core:__VERSION__
    environment:
      HOST: 0.0.0.0
      PORT: "3737"
      WORKJOURNAL_HOME: /data
      LOG_LEVEL: ${LOG_LEVEL:-info}
    volumes:
      - workjournal-data:/data
    # No ports: the core API and SQLite stay reachable only inside the
    # Compose network (web and mcp reach it at http://core:3737).
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:3737/health"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 10s
    restart: unless-stopped

  mcp:
    image: __BASE__-mcp:__VERSION__
    environment:
      MCP_TRANSPORT: http
      MCP_HTTP_HOST: 0.0.0.0
      MCP_PORT: "3738"
      WORKJOURNAL_CORE_URL: http://core:3737
      # Optional extra allowlist entries (comma-separated exact host:port /
      # origin values) if you publish on a different host port.
      MCP_ALLOWED_HOSTS: ${MCP_ALLOWED_HOSTS:-}
      MCP_ALLOWED_ORIGINS: ${MCP_ALLOWED_ORIGINS:-}
      # Optional bearer token; when set, clients must send
      # Authorization: Bearer <token> on every /mcp request.
      MCP_AUTH_TOKEN: ${MCP_AUTH_TOKEN:-}
    ports:
      - "127.0.0.1:${MCP_HOST_PORT:-3738}:3738"
    depends_on:
      core:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:3738/healthz"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 5s
    restart: unless-stopped

  web:
    image: __BASE__-web:__VERSION__
    environment:
      VITE_CORE_URL: http://core:3737
    ports:
      - "127.0.0.1:${WEB_PORT:-3000}:5173"
    depends_on:
      core:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:5173/"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 5s
    restart: unless-stopped

volumes:
  workjournal-data:
