{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@workjournal/shared": ["../shared/src/index.ts"],
      "@workjournal/core": ["../core/src/index.ts"],
      "@workjournal/mcp-adapter": ["../mcp-adapter/src/index.ts"],
      "@workjournal/mcp-adapter/config": ["../mcp-adapter/src/config.ts"],
      "@workjournal/mcp-adapter/autostart": ["../mcp-adapter/src/autostart.ts"],
      "@workjournal/mcp-adapter/http-server": ["../mcp-adapter/src/http-server.ts"],
      "@workjournal/mcp-adapter/stdio": ["../mcp-adapter/src/stdio.ts"],
      "@workjournal/mcp-adapter/validate-headers": ["../mcp-adapter/src/validate-headers.ts"],
      "@workjournal/mcp-adapter/server-factory": ["../mcp-adapter/src/server-factory.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
