# WorkJournal Core Service Configuration
# Copy to .env and adjust as needed

# Root directory for registry, exports, and project DBs
WORKJOURNAL_HOME=~/.workjournal

# Core service bind address (loopback only for security)
HOST=127.0.0.1
PORT=3737

# Logging level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Node environment
NODE_ENV=development

# Host projects directory (Docker deployments). Compose bind-mounts it into the
# core container at /host-projects; project registration maps host paths to
# container paths automatically. Windows example:
#   PROJECTS_DIRECTORY=C:/Users/meet.bhesaniya_moont/Documents/PROJECTS
# Leave unset for native development (any OS-native path can be registered).
PROJECTS_DIRECTORY=
